# Nexgradia Backend Environment Variables Template
# Copy this file to .env and adjust values for local development.
# NEVER commit the actual .env file or real passwords to version control.

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexgradia_db
DB_USER=nexgradia_user
DB_PASSWORD=your_secure_password_here

# Full Datasource URL (optional override, otherwise constructed from DB_HOST/DB_PORT/DB_NAME)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexgradia_db

# Security & JWT Configuration
JWT_SECRET=your_minimum_32_characters_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage Configuration
RESUME_STORAGE_DIR=storage/resumes
RESUME_MAX_FILE_SIZE_BYTES=5242880

